PORT=8790
HOST=0.0.0.0
ALLOWED_ORIGINS=http://127.0.0.1:8790,http://localhost:8790,https://whatsupdoc.fyi,https://www.whatsupdoc.fyi
DOC_AI_DB=./data/doc-ai.sqlite
NWS_USER_AGENT=DocAI/1.0 (contact: cclot1@brockport.edu; https://github.com/Scrum723/doc-ai)
OPENWEATHER_API_KEY=
DEFAULT_LOCATION=rochester
# No third-party LLM here. Alexa / Alexa+ is the language model.
# This server only exposes MCP weather tools + spoken fact strings.
# Auth mode for /mcp, /api/tools/:name and /api/public/chat: off | optional | required (default off).
DOC_MCP_AUTH_MODE=off
# Expected bearer. Under required on Lambda the server returns 503 until this is set.
# Alexa+ MCP config, doc-platform-web (DOC_AI_MCP_TOKEN) and weather-agi (DOC_AI_MCP_TOKEN) send the same value.
DOC_MCP_TOKEN=
